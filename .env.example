# ClickHouse Claude Agent — конфигурация
# Скопируйте этот файл в .env и заполните своими данными:
#   cp .env.example .env
# Файл .env НЕ добавляется в git (прописан в .gitignore).

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Получить ключ: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# ─── ClickHouse ───────────────────────────────────────────────────────────────
# Только hostname, без https://
CLICKHOUSE_HOST=your-host.mdb.yandexcloud.net
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=your_user
CLICKHOUSE_PASSWORD=your_password
CLICKHOUSE_DATABASE=your_database

# ─── SSL (Яндекс Cloud требует сертификат) ────────────────────────────────────
# Путь к файлу сертификата (абсолютный или относительный — от директории скрипта).
# Скачать: wget https://storage.yandexcloud.net/cloud-certs/CA.pem -O YandexInternalRootCA.crt
CLICKHOUSE_SSL_CERT_PATH=YandexInternalRootCA.crt
